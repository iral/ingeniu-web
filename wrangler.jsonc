{
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "ingeniu-web",
  "compatibility_date": "2025-12-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}